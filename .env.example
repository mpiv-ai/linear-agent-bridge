# Linear OAuth application (Settings -> API -> Applications -> new)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Webhook signing secret shown in the app's webhook section
LINEAR_WEBHOOK_SECRET=
# Optional bootstrap access token. The OAuth callback stores the rotating
# access and refresh tokens in OAUTH_TOKEN_STORE_PATH after the first
# authorization; from then on that store supersedes this value. Leave unset
# for a fresh install: the service boots and prints its authorization URL
# instead of requiring a placeholder.
LINEAR_ACCESS_TOKEN=
OAUTH_TOKEN_STORE_PATH=./data/oauth-tokens.json

# HTTP server
PORT=3979
# Canonical credential-free public URL used by deploy/verify-ingress.sh.
# It must use HTTPS and end exactly in /webhook.
WEBHOOK_URL=
# Redirect URI registered on the Linear OAuth2 Application and used for both
# authorization and token exchange; the two must match exactly. Defaults to
# http://localhost:<PORT>/oauth/callback, so changing PORT alone is enough
# for a non-default local port. Override this only when the browser doing
# the OAuth handshake reaches the bridge through a different host or port
# than PORT, e.g. a tunnel or a separately fronted public hostname. The path
# must stay exactly /oauth/callback; that is the only route the server
# handles.
OAUTH_REDIRECT_URI=

# Agent runtime: claude | codex. Codex inherits the service account's Codex
# login, default model, and reasoning effort.
RUNTIME=claude
# Claude authentication (the recommended default). Create a key in the Claude
# Console and put it here; it takes precedence over any stored Claude Code
# login on the service account. Leave it unset only if you run the bridge for
# yourself alone: Claude runs then use the service account's Claude Code login,
# and anyone who can mention the agent in your Linear workspace spends that
# personal subscription. See "Claude authentication" in the README.
ANTHROPIC_API_KEY=
# Directory agent sessions run in. Point this at the repo or knowledge base
# whose CLAUDE.md/MCP context the agent should carry. Defaults to the
# service's working directory.
KB_PATH=
# Optional. Directory the agent may write to. Unset means today's behaviour:
# the agent writes wherever its account can. Set it, then make the working tree
# read-only to the service account, and every artifact lands here instead.
# Enforcement is the filesystem, not this setting; see the README.
AGENT_OUTPUT_PATH=
# Where linear-session -> runtime-session mappings persist
SESSION_STORE_PATH=./data/sessions.json
# Durable webhook receipts, semantic execution claims, and caller-generated
# Linear activity UUIDs. Marker-free accepted turns also carry a short-lived,
# encrypted recovery envelope. Keep this on persistent local storage.
BRIDGE_STATE_STORE_PATH=./data/bridge-state.json
# Required 32-byte base64url key for ingress and goal-notice recovery envelopes.
# Generate with:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
INGRESS_RECOVERY_KEY=
# During rotation, retain up to four older keys as a comma-separated list with
# no spaces. New ingress and autonomous-notice envelopes use
# INGRESS_RECOVERY_KEY; recovery reads all keys.
INGRESS_RECOVERY_PREVIOUS_KEYS=

# Reconcile missed AgentSession prompt/stop webhooks on startup and this cadence.
RECONCILE_INTERVAL_MS=60000
# Discover recent app-owned sessions updated within this window.
RECONCILE_LOOKBACK_MS=86400000
# Maximum recent app-owned sessions per scan. Locally known sessions are always
# included in addition to this discovery cap.
RECONCILE_MAX_SESSIONS=250
# Warn when a user prompt has no durable bridge claim after this grace period.
AGENT_SESSION_ACK_GRACE_MS=120000

# Optional native autonomous-goal grant. Set this to the UUID of a visible
# Linear issue label (for example, "Autonomous"). A new Agent Session becomes
# autonomous only while its issue carries this label. Unset preserves v0.2.x
# one-turn behavior.
AUTONOMOUS_GOAL_LABEL_ID=
# Bound autonomous provider turns between human messages. Reaching the limit
# emits an elicitation and waits; it never silently retries.
AUTONOMOUS_GOAL_MAX_STEPS=8

# Stop a run after this long without runtime progress. Active runs have no
# wall-clock cap, and stop signals still cancel immediately.
RUN_INACTIVITY_TIMEOUT_MS=300000
# Bound on the graceful close after SIGINT or SIGTERM. Sized to sit inside
# launchd's 20-second SIGKILL window; systemd allows far longer.
SHUTDOWN_TIMEOUT_MS=10000
# Deprecated one-release fallback. Its presence logs one bounded warning:
# RUN_TIMEOUT_MS=300000

# Optional. Serve more Linear apps from this same process and webhook URL.
# JSON file with an "apps" array; each app has its own OAuth client, webhook
# signing secret, state directory, and target ("claude" or "codex").
# Secrets are referenced by *File path or *Env variable name, never inline.
# Unset keeps the single-app bridge configured above, unchanged. The format is
# documented in src/apps-config.ts.
BRIDGE_APPS_FILE=
# Optional. The default app's Linear app user id (viewer { id } on its
# token). When set, AgentSessionEvents naming another app user are rejected.
LINEAR_APP_USER_ID=
